    %0:gprb(s32) = COPY $x10
    %1:gprb(s32) = G_ADD %0, %0
    DBG_VALUE %1(s32), $noreg, !7, !DIExpression(), debug-location !9
    $x10 = COPY %1(s32)
    PseudoRET implicit $x10
